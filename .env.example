# Copy to .env.local and fill in. Never commit .env.local.
# Qloo hackathon key: only works against the hackathon API.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Keep harness state, npm cache and temp files inside the project folder.
QLOO_HOME=./.qloo
TMPDIR=./.tmp

# Ticketmaster Discovery API (free key from developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Anthropic API for the campaign-drafting agent
ANTHROPIC_API_KEY=

# Twilio WhatsApp sandbox (optional). A trial account cannot send free text, only Twilio templates:
# leave these empty and the campaign receipt says "WhatsApp: prepared, not sent".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Snapchat Marketing API (optional). Campaigns are created PAUSED.
SNAP_ACCESS_TOKEN=
SNAP_AD_ACCOUNT_ID=
# Real WhatsApp sends go only to this number (the judge's phone after joining the Twilio sandbox).
DEMO_WHATSAPP_TO=
# SQLite file. Default data/crowd.db; the Docker image sets /data/turnout.db on the mounted disk. Leave unset locally.
# DATABASE_PATH=data/crowd.db

# Agent provider: anthropic (needs ANTHROPIC_API_KEY) or operator (prompt files in data/agent-inbox)
AGENT_PROVIDER=

# Push: the hourly scan that drafts a campaign for the strongest new moment and alerts the merchant.
# 0 disables it. The alert links to APP_URL/campaigns/<id>.
SCAN_EVERY_MIN=60
APP_URL=http://localhost:3211

# Private Instagram / Facebook account connections (optional).
# Setup: docs/meta-channels.md. Leave blank until a Meta application is ready.
# Canonical HTTPS origin, without a path; use the same address in the browser.
TURNOUT_PUBLIC_URL=
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration using a USER access token.
META_LOGIN_CONFIG_ID=
# Credentials from the Instagram API with Instagram Login setup.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 32 random bytes encoded as 64 hex characters. Server only; keep a secure backup.
CHANNEL_TOKEN_KEY=
