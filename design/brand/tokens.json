{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Turnout",
  "identity": "Marquise",
  "version": "2.0.0",
  "color": {
    "surface": {
      "paper": { "value": "#F2F3F3", "role": "page" },
      "panel": { "value": "#FFFFFF", "role": "boards, fields" },
      "panel-2": { "value": "#F8F8F8", "role": "board without a rail, nested panels" },
      "tag": { "value": "#EBECEC", "role": "neutral tag fill" }
    },
    "line": {
      "default": { "value": "#E3E4E4", "role": "1 px hairline" },
      "strong": { "value": "#C9CBCD", "role": "field borders, table heads" }
    },
    "type": {
      "ink": { "value": "#111114", "contrastPaper": 16.96 },
      "ink-hover": { "value": "#2E2E30" },
      "text": { "value": "#26262C", "contrastPaper": 13.53 },
      "muted": { "value": "#62646B", "contrastPaper": 5.31, "contrastWhite": 5.91 },
      "placeholder": { "value": "#898B90", "contrastWhite": 3.41, "use": "placeholders only" }
    },
    "accent": {
      "value": { "value": "#E0115F", "contrastPaper": 4.28, "use": "live, hot, go: fills, marks, large type" },
      "ink": { "value": "#FFFFFF", "contrastOnAccent": 4.76 },
      "soft": { "value": "#FDE6EF", "use": "fill of a live tag only" },
      "text": { "value": "#B8094B", "contrastPaper": 5.94, "contrastWhite": 6.61, "use": "raspberry text, hover of raspberry fills" }
    },
    "status": {
      "ok": { "value": "#0B7A4E", "soft": "#E2F4EA", "contrastPaper": 4.83 },
      "warn": { "value": "#8A5D00", "soft": "#FCF0D6", "contrastPaper": 5.18 },
      "danger": { "value": "#B83A0A", "soft": "#FCE8E0", "contrastPaper": 5.18 }
    },
    "map": {
      "land": { "value": "#ECEDEC" },
      "hot": { "value": "#E0115F" },
      "cold": { "value": "#7C8794", "contrastLand": 3.11 },
      "sweep": { "value": "rgba(224, 17, 95, 0.22)", "use": "afterglow from floor line to needle, 0 to 22 %" },
      "style": "the MapLibre style is painted from land, cold and hot (RadarMap.tsx); no tile filter"
    },
    "mark": {
      "ink": { "value": "#111114" },
      "needle": { "value": "#E0115F", "use": "needle and afterglow" },
      "arc": { "value": "#606062", "use": "outer arc at 64 px and below: ink at 65 % over paper" },
      "arc-white": { "value": "#646466", "use": "same, over white" }
    }
  },
  "typography": {
    "family": {
      "display": { "value": "'Big Shoulders', 'Arial Narrow', sans-serif", "axes": { "opsz": "10..72", "wght": "600..900" }, "opticalSizing": "auto", "use": "names and numbers" },
      "sans": { "value": "'Instrument Sans', ui-sans-serif, system-ui, sans-serif", "weights": [400, 500, 600], "use": "sentences" },
      "mono": { "value": "'IBM Plex Mono', ui-monospace, monospace", "weights": [500], "use": "clock, distances, hex" }
    },
    "roles": {
      "wordmark": { "family": "display", "weight": 800, "case": "sentence", "tracking": "0", "trackingAt23px": "0.005em" },
      "hero": { "family": "display", "weight": 800, "size": 90, "lineHeight": 0.88, "tracking": "-0.012em" },
      "title": { "family": "display", "weight": 800, "lineHeight": 1, "tracking": "-0.005em" },
      "figure": { "family": "display", "weight": [700, 800], "numerals": "tabular-nums", "unit": "13 px muted sans after the figure" },
      "body": { "family": "sans", "weight": 400 },
      "label": { "family": "sans", "weight": 500, "size": [12, 13], "case": "sentence", "tracking": "0", "color": "{color.type.muted}" },
      "button": { "family": "sans", "weight": 600, "size": 15, "case": "sentence" },
      "clock": { "family": "mono", "weight": 500, "numerals": "tabular-nums" }
    }
  },
  "shape": {
    "radius": 0,
    "roundOnly": "map objects: venues are circles, your place is a square",
    "rail": { "width": 3, "color": "{color.type.ink}", "live": "{color.accent.value}" },
    "hairline": { "width": 1, "color": "{color.line.default}" },
    "shadow": "none (a 1 px hard line at most)"
  },
  "component": {
    "button": { "height": 44, "corners": 0, "variants": ["ink fill", "raspberry fill, once per screen", "1.5 px ink outline"] },
    "tag": { "height": 22, "corners": 0, "fill": "soft", "dot": "6 px square" },
    "field": { "height": 44, "corners": 0, "focus": "ink border plus a 1 px ink ring (focus is not live: no raspberry)" },
    "score": { "form": "20-segment marquee bar, one segment per 5 points" },
    "timeSeries": { "form": "square columns, hot window raspberry, now a 2 px ink line" }
  },
  "logo": {
    "name": "Swing, housed pivot",
    "geometry": "32-unit grid; datum on the wall-top line; walls 1.5 units; the needle pivots on a round hub set into the end of the left wall",
    "colours": { "ink": "#111114", "needleAndAfterglow": "#E0115F", "arc": "see arc" },
    "arc": {
      "128pxAndAbove": "0.25 unit (1 px at 128, 2 px at 256), full ink",
      "64px": "1 device px, --mark-arc (ink at 65 %)",
      "48, 32, 20, 16 px": "1 px, --mark-arc (ink at 65 %)",
      "innerRing": "never heavier than the arc"
    },
    "masters": [16, 20, 32, 48, 64, 128, 180],
    "lockup": { "alignment": "mark floor on the wordmark baseline", "header": "wordmark 23 px with the 20 px master on whole pixels, gap 6 px", "hero64": "gap 12 px" },
    "source": "design/studio-a/swing-final.mjs",
    "files": {
      "favicon": "src/app/icon.svg",
      "appleTouch": "src/app/apple-icon.png (from design/studio-a/marks/01-swing-final-180.svg)",
      "openGraph": "src/app/opengraph-image.png (from design/studio-a/01-swing-final-og.svg)",
      "masters": "design/studio-a/marks/01-swing-final-{16,20,32,48,hero,hero-large,180,mono,mono-16,reverse}.svg",
      "lockups": "design/studio-a/01-swing-final.svg (hero), design/studio-a/01-swing-final-lockup-header.svg (header)",
      "sheet": "design/studio-a/swing-final.html"
    }
  }
}
