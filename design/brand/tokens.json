{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Turnout",
  "version": "1.0.0",
  "color": {
    "surface": {
      "paper": { "value": "#F7F4EE", "role": "page background" },
      "panel": { "value": "#FFFFFF", "role": "cards, fields" },
      "panel-2": { "value": "#FBF9F5", "role": "flat cards, table headers, chips" },
      "panel-ink": { "value": "#17150F", "role": "reverse surfaces" }
    },
    "line": {
      "default": { "value": "#E4DED3" },
      "strong": { "value": "#CFC7B8" }
    },
    "ink": {
      "950": { "value": "#17150F", "contrastPaper": 16.63, "contrastWhite": 18.25 },
      "900": { "value": "#2A2721", "contrastPaper": 13.56, "contrastWhite": 14.89 },
      "700": { "value": "#4A463E", "contrastPaper": 8.55, "contrastWhite": 9.39 },
      "600": { "value": "#6B655B", "contrastPaper": 5.26, "contrastWhite": 5.77 },
      "500": { "value": "#857E71", "contrastPaper": 3.66, "contrastWhite": 4.02 },
      "400": { "value": "#A39C8F", "contrastPaper": 2.48, "contrastWhite": 2.72 },
      "300": { "value": "#CFC7B8", "contrastPaper": 1.53, "contrastWhite": 1.68 },
      "200": { "value": "#E4DED3", "contrastPaper": 1.22, "contrastWhite": 1.34 },
      "100": { "value": "#EFEBE3", "contrastPaper": 1.08, "contrastWhite": 1.19 },
      "50": { "value": "#FBF9F5", "contrastPaper": 1.04, "contrastWhite": 1.05 }
    },
    "amber": {
      "50": { "value": "#FBE9D9", "contrastPaper": 1.08 },
      "100": { "value": "#F5D3B4", "contrastPaper": 1.29 },
      "300": { "value": "#E0955A", "contrastPaper": 2.22 },
      "500": { "value": "#B4530A", "contrastPaper": 4.57, "contrastWhite": 5.02, "contrastAmber50": 4.25 },
      "600": { "value": "#9D4808", "contrastPaper": 5.69, "contrastWhite": 6.24 },
      "700": { "value": "#7F3A06", "contrastPaper": 7.62, "contrastWhite": 8.37 },
      "800": { "value": "#5E2B05", "contrastPaper": 10.49, "contrastWhite": 11.52 }
    },
    "role": {
      "ink": { "value": "{color.ink.950}" },
      "text": { "value": "{color.ink.900}" },
      "muted": { "value": "{color.ink.600}" },
      "faint": { "value": "{color.ink.500}" },
      "placeholder": { "value": "{color.ink.400}" },
      "accent": { "value": "{color.amber.500}" },
      "accent-hover": { "value": "{color.amber.600}" },
      "accent-ink": { "value": "#FFFFFF" },
      "accent-soft": { "value": "{color.amber.50}" },
      "accent-text": { "value": "#A54A07", "contrastPaper": 5.34, "contrastWhite": 5.86, "contrastAmber50": 4.96 }
    },
    "semantic": {
      "ok": { "value": "#1F7A4D", "soft": "#E3F3EA", "text": "#1B6B44", "contrastPaper": 4.84, "contrastOnSoft": 4.63, "whiteOn": 5.32 },
      "warn": { "value": "#9A6400", "soft": "#FFF3D6", "text": "#805300", "contrastPaper": 4.56, "textContrastPaper": 6.06, "textContrastOnSoft": 5.63 },
      "danger": { "value": "#B42318", "soft": "#FDE8E6", "text": "#B42318", "contrastPaper": 5.99, "contrastOnSoft": 5.59, "whiteOn": 6.57 },
      "info": { "value": "#3B5B7A", "soft": "#E6EDF3", "text": "#3B5B7A", "contrastPaper": 6.46, "contrastOnSoft": 6.00 }
    },
    "dataviz": {
      "sequential": ["#F3E6D6", "#EACBAA", "#DDA874", "#C97D3E", "#B4530A"],
      "neutral": ["#EFEBE3", "#D9D2C5", "#B8AF9F", "#857E71", "#4A463E"],
      "map": { "merchant": "#17150F", "hot": "#B4530A", "cold": "#CFC7B8", "radius": "#CFC7B8", "tileFilter": "saturate(0.55) contrast(0.95)" }
    }
  },
  "typography": {
    "family": {
      "display": { "value": "Fraunces, 'Iowan Old Style', Georgia, serif", "axes": { "opsz": "9..144", "wght": "300..700" } },
      "sans": { "value": "Inter, -apple-system, 'Helvetica Neue', Arial, sans-serif" }
    },
    "scale": [
      { "size": 12, "lineHeight": 16, "tracking": "0.01em", "family": "sans", "use": "table meta, captions" },
      { "size": 13, "lineHeight": 18, "tracking": "0", "family": "sans", "use": "secondary UI, table cells" },
      { "size": 14, "lineHeight": 20, "tracking": "0", "family": "sans", "use": "default UI, buttons, fields" },
      { "size": 16, "lineHeight": 24, "tracking": "0", "family": "sans", "use": "body copy" },
      { "size": 18, "lineHeight": 26, "tracking": "-0.005em", "family": "sans", "use": "lede, card titles in Inter" },
      { "size": 22, "lineHeight": 28, "tracking": "-0.01em", "family": "display", "use": "card titles, section heads", "opsz": 48 },
      { "size": 28, "lineHeight": 34, "tracking": "-0.015em", "family": "display", "use": "page section titles", "opsz": 72 },
      { "size": 36, "lineHeight": 42, "tracking": "-0.02em", "family": "display", "use": "page titles", "opsz": 96 },
      { "size": 48, "lineHeight": 52, "tracking": "-0.02em", "family": "display", "use": "hero, big numbers", "opsz": 144 },
      { "size": 64, "lineHeight": 66, "tracking": "-0.025em", "family": "display", "use": "marketing hero only", "opsz": 144 }
    ],
    "eyebrow": { "size": 11, "lineHeight": 16, "tracking": "0.14em", "weight": 600, "transform": "uppercase", "color": "{color.role.muted}" },
    "wordmark": { "family": "display", "weight": 500, "opsz": 144, "tracking": "-0.02em" },
    "numerals": { "data": "tabular-nums", "display": "proportional, Fraunces 500" },
    "weights": { "display": [500], "displayItalic": [500], "sans": [400, 500, 600] }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96, "unit": "px" },
  "container": { "lg": 1200, "md": 960, "sm": 640, "gutter": 24 },
  "radius": { "card": 14, "field": 10, "sm": 8, "pill": 999 },
  "shadow": {
    "default": "0 1px 2px rgba(23,21,15,0.04), 0 8px 24px -12px rgba(23,21,15,0.18)",
    "lift": "0 1px 2px rgba(23,21,15,0.05), 0 14px 32px -12px rgba(23,21,15,0.22)",
    "pop": "0 2px 4px rgba(23,21,15,0.06), 0 24px 48px -16px rgba(23,21,15,0.28)"
  },
  "border": { "width": 1, "color": "{color.line.default}" },
  "focus": { "outline": "2px solid #B4530A", "offset": 2, "fieldRing": "0 0 0 3px #FBE9D9" },
  "target": { "min": 40, "touch": 44 },
  "motion": {
    "duration": { "1": 120, "2": 200, "3": 320, "unit": "ms" },
    "easing": { "out": "cubic-bezier(0.2, 0, 0, 1)", "inOut": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "animates": ["score ring fill (dur-3)", "card hover lift 1px (dur-1)", "publish confirmation check (dur-3)", "badge colour change (dur-2)", "expand and collapse (dur-2)"],
    "never": ["page backgrounds", "the logo", "text colour on scroll", "table rows on load", "anything looping"]
  },
  "logo": {
    "mark": "design/logo/marks/01-threshold-mark.svg",
    "mark16": "design/logo/marks/01-threshold-mark-16.svg",
    "grid": 32,
    "clearSpace": "8 grid units (25 % of mark height) on all sides",
    "minimum": { "mark": 16, "horizontalLockupWordmark": 20, "stackedLockupWidth": 64 },
    "markToWordmark": { "markHeight": "1.15 x cap height", "capHeight": "0.70 em", "gap": "0.5 x cap height", "alignment": "floor of mark on wordmark baseline" }
  }
}
